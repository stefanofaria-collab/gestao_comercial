# ============================================================
# MYSQL CORPORATIVO - FONTE OFICIAL
# ============================================================
DB_HOST=seu-host-mysql
DB_PORT=3306
DB_NAME=beteltecprod
DB_USER=usuario_leitura
DB_PASSWORD=sua_senha
DB_CHARSET=utf8mb4
DB_SSL=false
DB_SSL_CA=

# ============================================================
# SUPABASE POSTGRESQL - CAMADA DE LEITURA DO DASHBOARD
# ============================================================
# Desenvolvimento local: Session Pooler (porta 5432)
# GitHub Actions: Transaction Pooler (porta 6543)
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=sua_senha_do_banco_supabase
SUPABASE_DB_SSLMODE=require

# ============================================================
# API
# ============================================================
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CACHE_TTL_SECONDS=300

# ============================================================
# SMTP — alertas de planos vencidos e códigos de acesso
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@clickdigital.com.br
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seu-email@clickdigital.com.br
SMTP_USE_SSL=false
SMTP_STARTTLS=true

APP_TIMEZONE=America/Sao_Paulo
SEND_HOUR=9
SEND_MINUTE=0
